# ──────────────────────────────────────────────────────
# Ayleen's AI Hub — 환경 변수 설정 파일
# 이 파일을 .env.local로 복사해서 실제 값을 채우세요
# ──────────────────────────────────────────────────────

# ① Vercel Postgres (또는 Supabase/Neon) DB URL
#    Vercel Dashboard → Storage → Create Database → Postgres → .env.local에 붙여넣기
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ② NextAuth 설정
#    NEXTAUTH_URL = 배포된 사이트 URL (로컬: http://localhost:3000)
NEXTAUTH_URL="https://your-site.vercel.app"
#    NEXTAUTH_SECRET = 랜덤 문자열 (터미널에서: openssl rand -base64 32)
NEXTAUTH_SECRET="your-random-secret-here"

# ③ 크론 잡 보안 키 (Vercel Cron이 API를 호출할 때 인증용)
#    랜덤 문자열 아무거나 (예: openssl rand -hex 16)
CRON_SECRET="your-cron-secret-here"

# ④ 최초 관리자 계정 생성용 비밀 키
#    배포 후 /api/setup으로 관리자 계정 1회 생성 후 삭제하거나 변경하세요
SETUP_SECRET="your-setup-secret-here"

# ⑤ NewsAPI 키 (선택, 없어도 RSS로 동작함)
#    https://newsapi.org → Register → Developer (무료 월 100회)
NEWS_API_KEY=""
