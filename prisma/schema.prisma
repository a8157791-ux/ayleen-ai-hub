// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AiNews {
  id          Int       @id @default(autoincrement())
  title       String
  titleKo     String?   // ✅ v3 추가: 한국어 번역 제목
  summary     String?
  summaryKo   String?   // ✅ v3 추가: 한국어 요약
  url         String    @unique
  source      String?
  category    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("ai_news")
}

model StudyNote {
  id          Int      @id @default(autoincrement())
  title       String
  content     String?
  category    String?
  tool        String?
  prompt      String?
  mediaUrl    String?
  tags        String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("study_notes")
}

model AiTool {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  url         String?
  category    String?
  pricing     String?
  rating      Float?
  review      String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ai_tools")
}

model PromptItem {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  category    String?
  tool        String?
  resultUrl   String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("prompt_items")
}

model SavedLink {
  id          Int      @id @default(autoincrement())
  title       String?
  url         String
  linkType    String?
  category    String?
  memo        String?
  createdAt   DateTime @default(now())

  @@map("saved_links")
}

model Reference {
  id          Int      @id @default(autoincrement())
  title       String?
  url         String
  refType     String?
  category    String?
  desc        String?
  faviconUrl  String?
  createdAt   DateTime @default(now())

  @@map("references")
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  @@map("admins")
}
